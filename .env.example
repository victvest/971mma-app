# =============================================================================
# 971 MMA — SINGLE SOURCE OF TRUTH for local secrets & config
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env` (gitignored).
#
# Layout:
#   A) EXPO_PUBLIC_*     → bundled into the mobile app (publishable only)
#   B) Local tooling     → scripts / supabase CLI / e2e (never EXPO_PUBLIC_)
#   C) Edge Function     → set in Supabase Dashboard → Edge Functions → Secrets
#                          (listed here so you have one checklist; values optional locally)
#   D) Store signing     → file paths + Apple/Google submit IDs (never commit key files)
#
# SECURITY RULES:
#   - NEVER put Mindbody, service_role, SMTP, Gemini, Salto, or signing secrets
#     in EXPO_PUBLIC_* — those ship inside the APK/IPA.
#   - Use only the Supabase ANON key in the mobile app. RLS is the real protection.
#   - Production EAS builds read EXPO_PUBLIC_* from Expo Dashboard → Environment variables,
#     not from this gitignored file.
#
# Compatibility:
#   `supabase/.env.local` should be a symlink to this file:
#     ln -sf ../.env supabase/.env.local
# =============================================================================


# -----------------------------------------------------------------------------
# A) MOBILE APP (Expo) — safe to embed in the client bundle
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Only `supabase` is supported. Direct Mindbody access from the app is disabled.
EXPO_PUBLIC_MEMBER_PROVIDER=supabase
EXPO_PUBLIC_CHECKIN_PROVIDER=supabase

# Coach schedule fixtures when live sync is empty. MUST be false in production.
EXPO_PUBLIC_COACH_DEMO_MODE=false

# Floating AI assistant for members.
EXPO_PUBLIC_PERSONA_ASSISTANT_ENABLED=true

# Skip Mindbody activation gate (local/dev only). MUST be false in production EAS builds.
EXPO_PUBLIC_SKIP_ACTIVATION_GATING=false

# Universal-link host for OAuth / password recovery (https://HOST/auth/callback).
EXPO_PUBLIC_AUTH_CALLBACK_HOST=app.971mma.com

# -----------------------------------------------------------------------------
# Native Google Sign-In (system account picker — NO browser redirect)
# Create OAuth clients: https://console.cloud.google.com/apis/credentials
# Bundle / package: com.victvest.ninemma
#
# Required:
#   1) Web application client  → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (+ secret for Supabase)
#   2) iOS client (Bundle ID)  → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
#   3) Android client (package + SHA-1 debug & release) — no env var; register in Google Cloud
#
# Supabase Dashboard → Authentication → Providers → Google:
#   - Enable Google
#   - Client IDs: WEB,iOS,ANDROID (web MUST be first, comma-separated)
#   - Client Secret: from the Web client
#   - Enable "Skip nonce check" (required for native iOS)
#
# After filling these, rebuild a native dev/prod client (Expo Go cannot show the modal).
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Legacy placeholder (unused by core flows; safe to leave).
# EXPO_PUBLIC_API_BASE_URL=

# Optional local gate geofence overrides (dev only)
# EXPO_PUBLIC_DEV_GATE_LAT=
# EXPO_PUBLIC_DEV_GATE_LNG=


# -----------------------------------------------------------------------------
# B) LOCAL TOOLING — scripts, supabase CLI, e2e (NOT bundled into the app)
# -----------------------------------------------------------------------------
# Database password (supabase db push / link)
SUPABASE_DB_PASSWORD=

# Service role — scripts/e2e only. NEVER EXPO_PUBLIC_*. NEVER commit a real value to git.
SUPABASE_SERVICE_ROLE_KEY=

# Signed-in smoke / e2e test user
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional E2E personas (falls back to TEST_USER for member)
# E2E_COACH_EMAIL=
# E2E_COACH_PASSWORD=
# E2E_GATE_EMAIL=
# E2E_GATE_PASSWORD=
# E2E_GUARDIAN_EMAIL=
# E2E_GUARDIAN_PASSWORD=
# E2E_PENDING_MEMBER_EMAIL=
# E2E_PENDING_MEMBER_PASSWORD=
# E2E_CHILD_PROFILE_ID=
# E2E_APP_ID=host.exp.Exponent
# E2E_EXPO_URL=exp://127.0.0.1:8081
# E2E_MAESTRO_DEBUG=true

# Custom SMTP (configure-auth-smtp / push-auth-config). Uses Resend SMTP for reliable email delivery.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@971mma.com
SMTP_SENDER_NAME=971 MMA

# Mindbody — used by local parity scripts; production values live in Edge secrets (section C)
MINDBODY_BASE_URL=https://api.mindbodyonline.com/public/v6
MINDBODY_API_KEY=
MINDBODY_SITE_ID=
MINDBODY_SOURCE_NAME=
MINDBODY_SOURCE_PASSWORD=
MINDBODY_LOCATION_ID=1
MINDBODY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# C) SUPABASE EDGE FUNCTION SECRETS — checklist (Dashboard or `supabase secrets set`)
#    Auto-injected by platform: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#    Keep copies here only if you need them for local `supabase functions serve`.
# -----------------------------------------------------------------------------
# QR_SIGNING_SECRET=
# GATE_SIGNING_SECRET=
# GATE_LOCATION_ID=
# ACADEMY_LAT=
# ACADEMY_LNG=
# GEOFENCE_RADIUS_M=100
# CRON_SECRET=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# PERSONA_DAILY_LIMIT=40
# MB_WRITE_ARRIVALS=true
# MB_ALLOW_CLIENT_CREATE=true
# MB_ALLOW_SELF_CHECKIN=true
# MB_DEFAULT_BIRTH_DATE=
# MB_DAILY_QUOTA=1000
# MB_MAX_CONCURRENT=4
# SALTO_API_BEARER_TOKEN=
# SALTO_ALLOWED_DEVICE_IDS=
# EXPO_PUSH_ACCESS_TOKEN=
# Comma-separated browser origins allowed to call admin-facing Edge Functions.
# Supports exact origins and a leading-host wildcard like `https://*.vercel.app`.
# Examples:
# ALLOWED_ORIGINS=https://admin.971mma.com,https://971mma-admin.vercel.app
# ALLOWED_ORIGINS=https://admin.971mma.com,https://*.vercel.app
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# ALLOWED_ORIGINS=


# -----------------------------------------------------------------------------
# D) STORE SIGNING & SUBMIT — paths + Apple/Google IDs (files stay gitignored)
# -----------------------------------------------------------------------------
# Android Play service account JSON (eas submit)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./store/google-service-account.json

# App Store Connect API key (.p8) — preferred for CI submit
EXPO_ASC_API_KEY_PATH=./store/AuthKey_XXXXXXXXXX.p8
EXPO_ASC_API_KEY_ID=
EXPO_ASC_API_KEY_ISSUER_ID=

# Or Apple ID auth (interactive / app-specific password)
# EXPO_APPLE_ID=
# EXPO_APPLE_TEAM_ID=
ASC_APP_ID=
APPLE_TEAM_ID=

# EAS Android ABI filter for APK profiles (optional)
# ANDROID_BUILD_ARCHS=arm64-v8a

# E2E local overrides — copy from .env.local.example
# TEST_USER_EMAIL and TEST_USER_PASSWORD are read from supabase/.env.local by default.

# Optional dedicated E2E personas (falls back to TEST_USER for member)
# E2E_COACH_EMAIL=
# E2E_COACH_PASSWORD=
# E2E_GATE_EMAIL=
# E2E_GATE_PASSWORD=
# E2E_GUARDIAN_EMAIL=
# E2E_GUARDIAN_PASSWORD=
# E2E_PENDING_MEMBER_EMAIL=
# E2E_PENDING_MEMBER_PASSWORD=
# E2E_CHILD_PROFILE_ID=

# Maestro app target — use host.exp.Exponent for Expo Go, com.bahaa0541.ninemma for dev/prod build
E2E_APP_ID=host.exp.Exponent
E2E_EXPO_URL=exp://127.0.0.1:8081

# Screenshot / debug output
E2E_MAESTRO_DEBUG=true

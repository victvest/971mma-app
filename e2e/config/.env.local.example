# Optional E2E overrides only.
# Shared secrets (Supabase, TEST_USER_*, Mindbody) live in 971mma-app/.env
# Copy this file to e2e/config/.env.local if you need Maestro-specific overrides.

# E2E_COACH_EMAIL=
# E2E_COACH_PASSWORD=
# E2E_GATE_EMAIL=
# E2E_GATE_PASSWORD=
# E2E_GUARDIAN_EMAIL=
# E2E_GUARDIAN_PASSWORD=
# E2E_PENDING_MEMBER_EMAIL=
# E2E_PENDING_MEMBER_PASSWORD=
# E2E_CHILD_PROFILE_ID=

# Expo Go (dev). For a native build / store binary use: com.victvest.ninemma
E2E_APP_ID=host.exp.Exponent
E2E_EXPO_URL=exp://127.0.0.1:8081
E2E_MAESTRO_DEBUG=true
